<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="700.0" stylesheets="@../resources/styles/MainMenuStyles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.diegomartinez.system.controller.MainMenuController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="encabezado">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>
         <children>
            <Label styleClass="titulo-encabezado" text="SISTEMA DE AUDITORIA - USUARIO" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="180.0" spacing="10.0" styleClass="menu-lateral" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="btnInicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#onInicio" text="Inicio" />
            <Button fx:id="btnPerfil" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#onPerfil" text="Perfil" />
            <Button fx:id="btnConfiguracion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#onConfiguracion" text="Configuración" />
            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#onCerrarSesion" text="Cerrar Sesión" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="panelCentral" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
